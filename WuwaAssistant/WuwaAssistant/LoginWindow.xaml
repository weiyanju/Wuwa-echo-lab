<Window x:Class="WuwaAssistant.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wuwa Assistant"
        Width="430"
        Height="420"
        MinWidth="390"
        MinHeight="390"
        ResizeMode="CanMinimize"
        Background="#F4F7FA">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Colors.xaml" />
                <ResourceDictionary Source="Styles/Controls.xaml" />
                <ResourceDictionary Source="Styles/Layout.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Margin="18" Style="{StaticResource ContentPanel}">
        <StackPanel>
            <TextBlock Text="Wuwa Assistant" Style="{StaticResource PageTitle}" />
            <TextBlock Text="登录系统账号后直接进入本地助手。" Style="{StaticResource PageDescription}" />

            <Border Style="{StaticResource InlineInfoCard}" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="系统账号" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                    <TextBlock Text="用户名" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                    <TextBox x:Name="UsernameBox" />
                    <TextBlock Text="密码" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                    <PasswordBox x:Name="PasswordBox" />
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="LoginButton" Grid.Column="0" Content="登录" Style="{StaticResource PrimaryButton}" Click="LoginButton_Click" />
                        <Button x:Name="RegisterButton" Grid.Column="2" Content="注册" Style="{StaticResource SecondaryButton}" Click="RegisterButton_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock x:Name="LoginStatusText" Text="请输入系统账号。" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</Window>
