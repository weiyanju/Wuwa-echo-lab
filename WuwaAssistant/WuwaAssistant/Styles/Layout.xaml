<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="ShellHeaderCard" TargetType="Border">
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Padding" Value="18" />
    </Style>

    <Style x:Key="NavigationRail" TargetType="Border">
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <Style x:Key="ContentPanel" TargetType="Border">
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="InlineInfoCard" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderBrush" Value="#E0E8EF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="#F8FBFD" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="StatusChip" TargetType="Border">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="#F2F6FA" />
        <Setter Property="Padding" Value="10,5" />
    </Style>

    <Style x:Key="StatusChipText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="EmptyStateCard" TargetType="Border">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="BorderBrush" Value="#E0E8EF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="#F8FBFD" />
        <Setter Property="Margin" Value="0,18,0,0" />
        <Setter Property="MinHeight" Value="220" />
    </Style>
</ResourceDictionary>
