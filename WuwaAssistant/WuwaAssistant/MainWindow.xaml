<Window x:Class="WuwaAssistant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wuwa Local Assistant" Height="720" Width="1040" MinHeight="620" MinWidth="900"
        Background="#F6F9FC">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1C2A35" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="BorderBrush" Value="#CBD8E4" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="BorderBrush" Value="#CBD8E4" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="BorderBrush" Value="#CBD8E4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#17232D" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="BorderBrush" Value="#1769D2" />
            <Setter Property="Background" Value="#1769D2" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="22" BorderBrush="#D8E4EE" BorderThickness="1" Background="White" Padding="22" Margin="0,0,0,18">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Wuwa Local Assistant" FontSize="24" FontWeight="Bold" />
                    <TextBlock Text="登录后端账号，读取游戏 UID，并提交固定识别样例。" Foreground="#627385" Margin="0,5,0,0" />
                </StackPanel>
                <TextBlock x:Name="StatusText" DockPanel.Dock="Right" Text="未登录" Foreground="#627385" VerticalAlignment="Center" FontWeight="SemiBold" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="18" BorderBrush="#D8E4EE" BorderThickness="1" Background="White" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="连接" FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="后端地址" Margin="0,16,0,6" FontWeight="SemiBold" />
                        <TextBox x:Name="BackendUrlBox" Text="http://127.0.0.1:8000" />

                        <TextBlock Text="系统账号" Margin="0,16,0,6" FontWeight="SemiBold" />
                        <TextBox x:Name="UsernameBox" />

                        <TextBlock Text="密码" Margin="0,12,0,6" FontWeight="SemiBold" />
                        <PasswordBox x:Name="PasswordBox" />

                        <Button x:Name="LoginButton" Content="登录后端" Style="{StaticResource PrimaryButton}" Margin="0,16,0,0" Click="LoginButton_Click" />

                        <Separator Margin="0,22,0,18" />

                        <TextBlock Text="游戏账号" FontSize="18" FontWeight="Bold" />
                        <Button x:Name="LoadAccountsButton" Content="读取 GameAccount" Margin="0,14,0,10" Click="LoadAccountsButton_Click" />
                        <ComboBox x:Name="AccountCombo" MinHeight="36" DisplayMemberPath="DisplayName" SelectionChanged="AccountCombo_SelectionChanged" />
                        <TextBlock x:Name="AccountHintText" Text="登录后读取当前账号绑定的 UID。" Foreground="#627385" TextWrapping="Wrap" Margin="0,10,0,0" />

                        <Separator Margin="0,22,0,18" />

                        <TextBlock Text="识别样例" FontSize="18" FontWeight="Bold" />
                        <Button x:Name="CreateSessionButton" Content="创建识别会话" Margin="0,14,0,0" Click="CreateSessionButton_Click" />
                        <Button x:Name="SubmitSampleButton" Content="提交固定样例快照" Margin="0,10,0,0" Click="SubmitSampleButton_Click" />
                        <Button x:Name="RevertButton" Content="回滚最后快照" Margin="0,10,0,0" Click="RevertButton_Click" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" CornerRadius="18" BorderBrush="#D8E4EE" BorderThickness="1" Background="White" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="诊断日志" FontSize="18" FontWeight="Bold" />
                        <TextBlock x:Name="LastSnapshotText" Text="尚未提交快照" Margin="18,3,0,0" Foreground="#627385" />
                    </StackPanel>
                    <TextBox x:Name="DiagnosticsBox"
                             Grid.Row="1"
                             Margin="0,14,0,0"
                             AcceptsReturn="True"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="13" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
