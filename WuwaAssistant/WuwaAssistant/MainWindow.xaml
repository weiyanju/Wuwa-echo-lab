<Window x:Class="WuwaAssistant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wuwa Local Assistant"
        Width="960"
        Height="680"
        MinWidth="820"
        MinHeight="560"
        Background="#F4F7FA">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Colors.xaml" />
                <ResourceDictionary Source="Styles/Controls.xaml" />
                <ResourceDictionary Source="Styles/Layout.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ShellHeaderCard}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Wuwa Assistant" FontSize="22" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                    <TextBlock Text="紧凑型本地识别工具" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource StatusChip}">
                        <TextBlock x:Name="StatusText" Text="未登录" Style="{StaticResource StatusChipText}" />
                    </Border>
                    <Border Style="{StaticResource StatusChip}" Margin="8,0,0,0">
                        <TextBlock x:Name="ShellStatusText" Text="UID 未选择" Style="{StaticResource StatusChipText}" />
                    </Border>
                    <Border Style="{StaticResource StatusChip}" Margin="8,0,0,0">
                        <TextBlock x:Name="RecognitionStateText" Text="识别已停止" Style="{StaticResource StatusChipText}" />
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="148" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="AssistantNav" Grid.Column="0" Style="{StaticResource NavigationRail}">
                <StackPanel>
                    <TextBlock Text="功能" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" Margin="8,0,8,10" />
                    <Button x:Name="HomeTabButton" Content="首页" Tag="Home" Style="{StaticResource NavButton}" Click="NavButton_Click" />
                    <Button x:Name="RecognitionTabButton" Content="识别" Tag="Recognition" Style="{StaticResource NavButton}" Click="NavButton_Click" />
                    <Button x:Name="CaptureOcrTabButton" Content="截图/OCR" Tag="CaptureOcr" Style="{StaticResource NavButton}" Click="NavButton_Click" />
                    <Button x:Name="DiagnosticsTabButton" Content="日志" Tag="Diagnostics" Style="{StaticResource NavButton}" Click="NavButton_Click" />
                    <Button x:Name="SettingsTabButton" Content="设置" Tag="Settings" Style="{StaticResource NavButton}" Click="NavButton_Click" />
                </StackPanel>
            </Border>

            <Grid Grid.Column="2">
                <Border x:Name="HomePagePanel" Style="{StaticResource ContentPanel}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid MaxWidth="760">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="首页" Style="{StaticResource PageTitle}" />
                            <TextBlock Grid.Row="1" Text="查看当前账号与本地识别状态，未绑定 UID 时可在这里完成初始化。" Style="{StaticResource PageDescription}" />
                            <UniformGrid Grid.Row="2" Columns="3" Margin="0,22,0,0">
                                <Border Style="{StaticResource InlineInfoCard}" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="系统账号" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                                        <TextBlock x:Name="AccountSummaryText" Text="未登录" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InlineInfoCard}" Margin="4,0,4,0">
                                    <StackPanel>
                                        <TextBlock Text="游戏 UID" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                                        <TextBlock x:Name="CurrentUidText" Text="未选择" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InlineInfoCard}" Margin="8,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="识别状态" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                                        <TextBlock x:Name="RecognitionSummaryText" Text="等待开始" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                            <Border x:Name="UidSetupPanel" Grid.Row="3" Style="{StaticResource InlineInfoCard}" Margin="0,22,0,0" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="初始化游戏 UID" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                                    <TextBlock Text="当前系统账号还没有可用 UID。输入游戏 UID 后，助手会把它保存到后端并作为当前默认 UID。" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="140" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="InitialUidBox" Grid.Column="0" />
                                        <Button x:Name="BindUidButton" Grid.Column="2" Content="保存 UID" Style="{StaticResource PrimaryButton}" Click="BindUidButton_Click" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Border>

                <Border x:Name="RecognitionPagePanel" Style="{StaticResource ContentPanel}" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid MaxWidth="760">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="识别" Style="{StaticResource PageTitle}" />
                            <TextBlock Grid.Row="1" Text="当前阶段保留样例快照链路，后续会接入 fake pipeline、窗口检测和本地离线 OCR。" Style="{StaticResource PageDescription}" />
                            <UniformGrid Grid.Row="2" Columns="3" Margin="0,22,0,0">
                                <Button x:Name="CreateSessionButton" Content="创建识别会话" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="CreateSessionButton_Click" />
                                <Button x:Name="SubmitSampleButton" Content="提交固定样例快照" Style="{StaticResource PrimaryButton}" Margin="4,0,4,0" Click="SubmitSampleButton_Click" />
                                <Button x:Name="RevertButton" Content="回滚最后快照" Style="{StaticResource CautionButton}" Margin="8,0,0,0" Click="RevertButton_Click" />
                            </UniformGrid>
                            <Border Grid.Row="3" Style="{StaticResource InlineInfoCard}" Margin="0,22,0,0">
                                <StackPanel>
                                    <TextBlock Text="最近结果" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                                    <TextBlock x:Name="LastSnapshotText" Text="尚未提交快照" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Border>

                <Border x:Name="CaptureOcrPagePanel" Style="{StaticResource ContentPanel}" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="截图/OCR" Style="{StaticResource PageTitle}" />
                        <TextBlock Grid.Row="1" Text="真实窗口检测、截图 hash 和本地离线 OCR 会在后续阶段接入。" Style="{StaticResource PageDescription}" />
                        <Border Grid.Row="2" Style="{StaticResource EmptyStateCard}">
                            <TextBlock Text="等待接入窗口检测与本地离线 OCR" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <Border x:Name="DiagnosticsPagePanel" Style="{StaticResource ContentPanel}" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="日志" Style="{StaticResource PageTitle}" />
                        <TextBlock Grid.Row="1" Text="诊断日志用于解释账号加载、样例提交、回滚和后续识别状态。" Style="{StaticResource PageDescription}" />
                        <TextBox x:Name="DiagnosticsBox"
                                 Grid.Row="2"
                                 Margin="0,16,0,0"
                                 AcceptsReturn="True"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 FontSize="13" />
                    </Grid>
                </Border>

                <Border x:Name="SettingsPagePanel" Style="{StaticResource ContentPanel}" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="设置" Style="{StaticResource PageTitle}" />
                        <TextBlock Grid.Row="1" Text="本地设置、OCR Provider 和后台检测频率会在后续阶段拆入独立模块。" Style="{StaticResource PageDescription}" />
                        <Border Grid.Row="2" Style="{StaticResource EmptyStateCard}">
                            <TextBlock Text="设置模块待接入" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
