# Copy this file to /etc/wuwa/wuwa.env on the production server.
# Keep the deployed file owned by root:piaobozhe with mode 0640.
# Replace every CHANGE_ME and example.com value before deployment.

WUWA_ENV=production
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=CHANGE_ME_generate_at_least_50_random_characters
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_CORS_ALLOWED_ORIGINS=
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false

DB_NAME=wuwa
DB_USER=wuwa_app
DB_PASSWORD=CHANGE_ME_generate_a_unique_database_password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

WUWA_HEALTHCHECK_URL=https://example.com/api/health/
